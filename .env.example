# WxPusher 标准推送：管理后台 https://wxpusher.zjiecode.com/admin/ 创建应用后获取
WXPUSHER_APP_TOKEN=AT_xxx
# 接收人 UID，多个用英文逗号分隔（微信搜「wxpusher」公众号 → 我的 → 我的 UID）
WXPUSHER_UIDS=UID_xxx
# 主题群发（可选，可与 UID 并存）
#WXPUSHER_TOPIC_IDS=123

# 轮询间隔，毫秒
POLL_MS=60000
# 监控范围：buy 仅主动积存价 / sell 仅赎回价 / both 两者
WATCH_PRICE=both
# 最小变动阈值（分），0 表示任何变动都推送
MIN_DELTA_FEN=0
# 连续取数失败多少次后推送异常提醒
ALERT_AFTER_FAILURES=5
# 首次运行是否推送当前价格（默认仅记录基准，不推送）
PUSH_ON_START=0
# 试运行：1 只打印不推送（注意：dry-run 同样会推进去重基准）
DRY_RUN=1
# 单次取数超时，毫秒
REQUEST_TIMEOUT_MS=80000
